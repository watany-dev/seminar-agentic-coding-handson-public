{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": { "include": ["src/**", "test/**", "public/**/*.js"] },
  "formatter": { "enabled": false },
  "organizeImports": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": { "noUnusedVariables": "error", "noUnusedImports": "error" }
    }
  }
}
